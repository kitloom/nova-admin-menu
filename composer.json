{
    "name": "kitloom/nova-admin-menu",
    "description": "Reorder the Laravel Nova main menu from the admin panel: weights for tools, resources and dashboards, stored in the database instead of hardcoded in the service provider.",
    "keywords": [
        "laravel",
        "nova",
        "menu",
        "sidebar",
        "navigation",
        "sorting"
    ],
    "homepage": "https://github.com/kitloom/nova-admin-menu",
    "license": "MIT",
    "authors": [
        {
            "name": "kitloom",
            "email": "kitloom@kitloom.dev",
            "homepage": "https://github.com/kitloom"
        }
    ],
    "support": {
        "issues": "https://github.com/kitloom/nova-admin-menu/issues",
        "source": "https://github.com/kitloom/nova-admin-menu"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "laravel/nova": "^5.0",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kitloom\\NovaAdminMenu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kitloom\\NovaAdminMenu\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kitloom\\NovaAdminMenu\\NovaAdminMenuServiceProvider"
            ],
            "aliases": {
                "AdminMenu": "Kitloom\\NovaAdminMenu\\Facades\\AdminMenu"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    },
    "repositories": {
        "nova": {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    }
}
